#!/usr/bin/env python3
"""
Robust grep wrapper for opencode.
Usage:  python .opencode/bin/grep --pattern='<regex>' [--path=<dir>] [--ignore-case] [--max=<n>]
        echo '{"pattern":"foo","path":"."}' | python .opencode/bin/grep
Avoids ripgrep's 65536-byte JSON record overflow by using plain --line-number output.
Falls back to a pure-Python scanner when ripgrep is unavailable.
"""
import sys, json, os, re, subprocess, datetime

RG_LINE_RE = re.compile(r"^(.+?):(\d+):(.*)$")

def find_rg():
    for name in ("rg", "ripgrep"):
        try:
            r = subprocess.run(["where", name], capture_output=True, text=True, timeout=5)
            if r.returncode == 0 and r.stdout.strip():
                return r.stdout.strip().splitlines()[0]
        except Exception:
            continue
    return None

def scan_python(pattern, root, ignore_case, max_results):
    """Pure-Python fallback: walk root (file or dir), match lines, return matches."""
    rx = re.compile(pattern, re.IGNORECASE if ignore_case else 0)
    matches = []
    errors = []

    def scan_file(fp):
        try:
            if os.path.getsize(fp) > 20 * 1024 * 1024:
                return False
            with open(fp, "r", encoding="utf-8", errors="replace") as f:
                for i, line in enumerate(f, 1):
                    if rx.search(line):
                        matches.append({"file": fp, "line": i, "text": line.rstrip("\n")[:500]})
                        if len(matches) >= max_results:
                            return True
        except (OSError, UnicodeError):
            return False
        return False

    if os.path.isfile(root):
        scan_file(root)
        return matches, errors, len(matches) >= max_results

    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if d not in {
            ".git", "node_modules", "__pycache__", ".venv", "venv",
            ".mypy_cache", ".pytest_cache", ".ruff_cache", "dist", "build"}]
        for fn in filenames:
            if len(matches) >= max_results:
                return matches, errors, True
            if scan_file(os.path.join(dirpath, fn)):
                return matches, errors, True
    return matches, errors, False

def main():
    args = {}
    rest = []
    for a in sys.argv[1:]:
        if a.startswith("--"):
            k, _, v = a.partition("=")
            args[k.lstrip("-")] = v
        else:
            rest.append(a)
    # Read stdin only if piped (never block on interactive TTY)
    if not sys.stdin.isatty():
        try:
            data = sys.stdin.read()
            if data.strip():
                j = json.loads(data)
                if isinstance(j, dict):
                    args = {**args, **j}
        except Exception:
            pass
    pattern = args.get("pattern")
    if pattern is None and rest:
        pattern = rest[0]
        rest = rest[1:]
    if not pattern:
        print(json.dumps({"success": False,
                          "message": "Usage: grep --pattern=<regex> [--path=<dir>] [--ignore-case] [--max=<n>]"}),
              file=sys.stderr)
        sys.exit(2)
    path = args.get("path", ".") or "."
    if not os.path.exists(path):
        print(json.dumps({"success": False, "message": f"Path not found: {path}"}), file=sys.stderr)
        sys.exit(1)
    if os.path.isfile(path):
        scan_paths = [path]
    else:
        scan_paths = [path]
    ignore_case = str(args.get("ignoreCase", args.get("ignore_case", "false"))).lower() in ("1","true","yes","on")
    try:
        max_results = int(args.get("max", 500))
    except Exception:
        max_results = 500
    if max_results <= 0:
        max_results = 500

    matches = []
    errors = []
    truncated = False
    rg = find_rg()
    if rg:
        cmd = [rg, "--line-number", "--no-messages", "--max-columns", "500"]
        if ignore_case:
            cmd.append("-i")
        cmd += ["--", pattern, path]
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, timeout=120,
                                  encoding="utf-8", errors="replace")
            for line in proc.stdout.splitlines():
                m = RG_LINE_RE.match(line)
                if m:
                    matches.append({"file": m.group(1), "line": int(m.group(2)), "text": m.group(3)[:500]})
                else:
                    matches.append({"raw": line[:500]})
                if len(matches) >= max_results:
                    truncated = True
                    break
            if proc.returncode not in (0, 1) and proc.stderr:
                errors.append(proc.stderr.strip()[:500])
        except Exception as e:
            errors.append(f"ripgrep failed: {e}")
            matches = []
    if not matches and not errors and rg is None:
        matches, errors, truncated = scan_python(pattern, path, ignore_case, max_results)
    elif not matches and errors:
        # ripgrep failed, try python fallback
        matches, errors2, truncated = scan_python(pattern, path, ignore_case, max_results)
        errors.extend(errors2)

    result = {
        "success": not errors,
        "pattern": pattern,
        "path": path,
        "matchCount": len(matches),
        "matches": matches,
        "truncated": truncated,
        "engine": "rg" if rg else "python",
        "timestamp": datetime.datetime.now().isoformat(),
    }
    if errors:
        result["errors"] = errors
    print(json.dumps(result))
    sys.exit(0 if not errors else 1)

if __name__ == "__main__":
    main()
