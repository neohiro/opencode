#!/usr/bin/env python3
"""
Robust bash wrapper for opencode.
Usage:  python .opencode/bin/bash --command='<cmd>' [--workdir=<dir>] [--timeout=<sec>]
        echo '{"command":"ls -l"}' | python .opencode/bin/bash
Note: Reads stdin ONLY when stdin is not a TTY (to avoid hangs in interactive mode).
Returns JSON with exitCode/stdout/stderr.
"""
import sys, json, subprocess, os, datetime

def fatal(msg, code=1):
    print(json.dumps({"success": False, "exitCode": code, "message": msg,
                      "timestamp": datetime.datetime.now().isoformat()}), file=sys.stderr)
    sys.exit(code)

def parse_args():
    args = {}
    rest = []
    for a in sys.argv[1:]:
        if a.startswith("--"):
            k, _, v = a.partition("=")
            args[k.lstrip("-")] = v
        else:
            rest.append(a)
    stdin_json = None
    # Only read stdin when it is actually piped; never block an interactive TTY.
    if not sys.stdin.isatty():
        try:
            data = sys.stdin.read()
            if data.strip():
                stdin_json = json.loads(data)
        except Exception:
            pass
    cmd = args.get("command")
    if stdin_json is not None:
        args = {**args, **stdin_json}
        cmd = args.get("command", cmd)
    if cmd is None and rest:
        cmd = " ".join(rest)
    workdir = args.get("workdir", args.get("cwd", None))
    timeout_str = args.get("timeout", args.get("timeout", "300"))
    try:
        timeout = float(timeout_str)
    except Exception:
        timeout = 300.0
    return cmd, workdir, timeout

cmd, workdir, timeout = parse_args()
if cmd is None:
    fatal('Usage: bash --command="<cmd>" [--workdir=<dir>] [--timeout=<sec>]')

env = dict(os.environ)
# True bash location
bash_exe_candidates = [
    r"C:\Program Files\Git\bin\bash.exe",
    r"C:\Program Files\Git\usr\bin\bash.exe",
]
bash_exe = None
for p in bash_exe_candidates:
    if os.path.isfile(p):
        bash_exe = p
        break
if bash_exe is None:
    try:
        r = subprocess.run(["where", "bash"], capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            bash_exe = r.stdout.strip().splitlines()[0]
    except Exception:
        pass

cwd = os.path.abspath(os.path.expanduser(str(workdir))) if workdir else None
if cwd is not None and not os.path.isdir(cwd):
    cwd = None

# Helper to detect the specific broken-bash failure observed on this machine
BROKEN_KEYWORDS = ["fork: retry: Resource temporarily unavailable", "dofork", "0xC0000142"]

def is_broken_bash(stderr_text):
    low = stderr_text.lower()
    return any(kw in stderr_text for kw in BROKEN_KEYWORDS)

proc = None
if bash_exe:
    try:
        proc = subprocess.run([bash_exe, "-c", cmd], capture_output=True, text=True,
                              timeout=timeout, encoding="utf-8", errors="replace",
                              env=env, cwd=cwd)
        if proc.returncode == 254 or (proc.returncode != 0 and is_broken_bash(proc.stderr)):
            # Bash failed due to environment (DLL/fork issue) — fall back to native shell
            proc = None
    except Exception as e:
        proc = None

if proc is None:
    # Fallback: use Python's native shell execution (cmd / PowerShell) without bash semantics
    try:
        proc = subprocess.run(cmd, shell=True, capture_output=True, text=True,
                              timeout=timeout, encoding="utf-8", errors="replace",
                              env=env, cwd=cwd)
    except Exception as e:
        # Even the native shell failed; emit structured failure.
        print(json.dumps({"success": False, "exitCode": 1,
                          "stdout": "", "stderr": str(e),
                          "command": cmd, "workdir": cwd,
                          "timestamp": datetime.datetime.now().isoformat()}))
        sys.exit(1)

result = {
    "success": proc.returncode == 0,
    "exitCode": proc.returncode,
    "stdout": proc.stdout[:50000],
    "stderr": proc.stderr[:50000],
    "command": cmd,
    "workdir": cwd,
    "timestamp": datetime.datetime.now().isoformat(),
}
print(json.dumps(result))
# If bash was broken but native shell succeeded, note it in stderr quietly.
if bash_exe and proc.returncode == 0 and (proc.stderr and is_broken_bash(proc.stderr)):
    # Already handled above; this branch catches if broken bash somehow returned 0 with broken stderr.
    pass
sys.exit(proc.returncode)
